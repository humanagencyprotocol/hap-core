{
  "suite": "device-keys/encoding",
  "description": "base64url, signed bytes, entry hash, key id",
  "cases": [
    {
      "id": "b64u-decode-ok",
      "op": "b64u.decode",
      "input": {
        "text": "AQID_-A"
      },
      "expect": {
        "hex": "010203ffe0"
      }
    },
    {
      "id": "b64u-padding-refused",
      "op": "b64u.decode",
      "input": {
        "text": "AQID_-A="
      },
      "expect": {
        "error": "MALFORMED"
      }
    },
    {
      "id": "b64u-standard-alphabet-refused",
      "op": "b64u.decode",
      "input": {
        "text": "AQID/+A"
      },
      "expect": {
        "error": "MALFORMED"
      }
    },
    {
      "id": "b64u-non-canonical-trailing-bits",
      "op": "b64u.decode",
      "input": {
        "text": "AQIE_-B"
      },
      "expect": {
        "error": "MALFORMED"
      }
    },
    {
      "id": "b64u-bad-length",
      "op": "b64u.decode",
      "input": {
        "text": "A"
      },
      "expect": {
        "error": "MALFORMED"
      }
    },
    {
      "id": "signed-bytes-exclude-sig-sigs-checks",
      "op": "signed_bytes",
      "input": {
        "object": {
          "z": 1,
          "a": [
            "é",
            {
              "b": null,
              "a": true
            }
          ],
          "typ": "x",
          "v": 1,
          "sigs": [
            {
              "by": "x"
            }
          ],
          "checks": [],
          "sig": "dropped"
        }
      },
      "expect": {
        "bytes_utf8": "{\"a\":[\"é\",{\"a\":true,\"b\":null}],\"typ\":\"x\",\"v\":1,\"z\":1}",
        "hash": "sha256:87b283c340e5453c409c9e0209b7cc27801578005e8c48238a2caff94825dd66"
      }
    },
